# ============================================================
# MINEINTEL ENVIRONMENT CONFIGURATION
# Evidence Intelligence for Mining & Geological Operations
# CMPDI / Coal India Limited (Problem Statement ID: 26023)
# ============================================================

APP_NAME=MineIntel
APP_ENV=development
DEBUG=true
VERSION=0.1.0

# Database Configuration
# Default SQLite for instant local execution:
DATABASE_URL=sqlite:///./data/mineintel.db
# Or PostgreSQL for production / Docker deployment:
# DATABASE_URL=postgresql://mineintel_user:mineintel_password@localhost:5432/mineintel_db

# File Storage Paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=50

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operational Flags
DEMO_MODE=true
AUTO_PROCESS_UPLOADS=false
