# ============================================================
# MINEINTEL ENVIRONMENT CONFIGURATION
# Evidence Intelligence for Mining & Geological Operations
# CMPDI / Coal India Limited (Problem Statement ID: 26023)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

APP_NAME=MineIntel
APP_ENV=development
DEBUG=true
VERSION=0.2.0

# ─── Database ──────────────────────────────────────────────
# Default: SQLite for instant local execution
DATABASE_URL=sqlite:///./data/mineintel.db
# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql://mineintel_user:CHANGE_ME@localhost:5432/mineintel_db

# ─── File Storage ──────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=50

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ─── JWT Authentication ────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── Demo User Passwords (only used in DEMO_MODE) ──────────
# These are documented defaults for the SIH demo. Change in any deployment.
DEMO_ANALYST_PASSWORD=Analyst@Demo2026
DEMO_REVIEWER_PASSWORD=Reviewer@Demo2026
DEMO_ADMIN_PASSWORD=Admin@Demo2026!

# ─── AI Provider (Google Gemini — optional) ────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Operational Flags ─────────────────────────────────────
DEMO_MODE=true
AUTO_PROCESS_UPLOADS=false

# ─── PostgreSQL (Docker Compose) ───────────────────────────
# Only needed when DATABASE_URL uses PostgreSQL
POSTGRES_USER=mineintel_user
POSTGRES_PASSWORD=CHANGE_ME_set_a_strong_db_password
POSTGRES_DB=mineintel_db
