# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.tox/
.coverage
.pytest_cache/
htmlcov/
.mypy_cache/
.ruff_cache/
.pytype/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
ENV/

# ─── Database (NEVER commit live/user databases) ──────────────────────────────
# The databases below contain user data and are excluded from source control.
# Use Alembic migrations to recreate schema from scratch.
data/mineintel.db
data/test_mineintel.db
backend/data/mineintel.db
backend/data/test_mineintel.db
backend/mineintel.db
*.db
*.db-shm
*.db-wal

# ─── Uploads and generated reports ───────────────────────────────────────────
# Uploaded user files and generated PDFs must NOT be committed.
data/uploads/
data/uploads/*
data/reports/
data/reports/*
backend/data/uploads/
backend/data/uploads/*
backend/data/reports/
backend/data/reports/*

# ─── Frontend build outputs & dependencies ───────────────────────────────────
node_modules/
**/node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/

# ─── Secrets / environment ────────────────────────────────────────────────────
# NEVER commit .env with real keys. Use .env.example as template.
.env
**/.env
!.env.example

# ─── Backups (local only) ─────────────────────────────────────────────────────
backups/
_backups/
**/backups/
**/_backups/

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
